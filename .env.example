# ApplyForge AI Configuration

# Optional: Tavily Search API Key for enhanced company research
# If left empty, ApplyForge AI automatically falls back to live DuckDuckGo web search
# Get a key at: https://tavily.com
TAVILY_API_KEY=

# Local Ollama Endpoint (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Target Model Name (Installed locally in Ollama)
OLLAMA_MODEL=gemma3:4b
